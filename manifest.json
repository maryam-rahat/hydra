{
    "manifest_version": 3,
    "name": "Hydra",
    "version": "1.0",
    "description": "A tiny hydration companion.",

    "permissions": [
        "storage",
        "alarms",
        "notifications"
    ],

    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },

    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },

    "background": {
        "service_worker": "background.js"
    }
}